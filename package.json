{
  "name": "bike-supply-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "rm -rf .preview && mkdir .preview && ln -s ../.output/public .preview/BikeSupplyMap && serve .preview --symlinks -l 3001",
